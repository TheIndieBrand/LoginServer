# Discord Developer Portal -> tu aplicación -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Debe coincidir con la redirect URI registrada en Discord
DISCORD_REDIRECT_URI=https://login.theindiebrand.es/auth/discord/callback

# Secreto para firmar los JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET=

# Dominio de la cookie (con punto para compartirla entre subdominios). En local, déjalo vacío.
COOKIE_DOMAIN=.theindiebrand.es
# true en producción (HTTPS); false en local
COOKIE_SECURE=true

# Sufijo permitido para redirecciones (open redirect protection)
ALLOWED_REDIRECT_SUFFIX=theindiebrand.es

BIND_ADDR=127.0.0.1:3000
DATABASE_PATH=login.db
